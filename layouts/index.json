[
{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- range $i, $p := $pages -}}
{{- if $i }},{{ end }}
{
  "no": {{ with $p.File }}{{ $raw := replaceRE "^([0-9]+).*$" "$1" .ContentBaseName }}{{ if findRE "^[0-9]+$" $raw }}{{ printf "%03d" (int $raw) | jsonify }}{{ else }}""{{ end }}{{ else }}""{{ end }},
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.RelPermalink | jsonify }},
  "date": {{ $p.Date.Format "2006.01.02" | jsonify }},
  "summary": {{ with $p.Summary }}{{ . | plainify | htmlUnescape | truncate 120 | jsonify }}{{ else }}""{{ end }},
  "tags": {{ $p.Params.tags | default slice | jsonify }},
  "body": {{ $p.Plain | truncate 3000 | jsonify }}
}
{{- end -}}
]
