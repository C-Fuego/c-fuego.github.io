{{ $posts := where site.RegularPages "Section" "posts" }}
{{ $out := slice }}
{{ range $posts }}
  {{ $summary := "" }}
  {{ with .Params.summary }}{{ $summary = . }}{{ else }}{{ $summary = .Summary | plainify | truncate 120 "" }}{{ end }}
  {{ $out = $out | append (dict
      "t" .Title
      "u" .RelPermalink
      "d" (.Date.Format "2006.01.02")
      "s" $summary
      "g" (delimit .Params.tags ",")
      "c" (.Plain | truncate 4000 "")
  ) }}
{{ end }}
{{ $out | jsonify }}
