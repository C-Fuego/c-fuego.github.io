#!/bin/sh
# 发布到 GitHub Pages
# 用法: bin/pub "本次改了什么"
#   commit → push → GitHub Actions 自动构建发布
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$APP_DIR"

MSG=${1:-}
if [ -z "$MSG" ]; then
  echo "用法: bin/pub \"本次改了什么\"" >&2
  exit 1
fi

if [ -z "$(git status --porcelain)" ]; then
  echo "工作区没有改动，不用发。" >&2
  exit 0
fi

echo "== 1/3 本地构建检查 =="
hugo --gc --minify --quiet
test -f public/index.html || { echo "!! 构建产物缺失，已中止" >&2; exit 1; }

echo "== 2/3 提交 =="
git add -A
git commit -q -m "$MSG"
git --no-pager log --oneline -1

echo "== 3/3 推送 =="
git push -q origin main
echo "已推送。构建状态: https://github.com/C-Fuego/blog/actions"
echo "站点地址:     https://c-fuego.github.io/blog/"
